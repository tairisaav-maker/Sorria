# =============================================================================
# PUBLIC (browser-safe) — NEXT_PUBLIC_*
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo mode: UI exploration without live Supabase. Never enable in production.
NEXT_PUBLIC_DEMO_MODE=true

# =============================================================================
# SERVER-ONLY — never expose to the browser / client bundle
# =============================================================================
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Demo credentials (server-validated). Change in any shared environment.
DEMO_EMAIL=demo@sorria.app
DEMO_PASSWORD=sorria-demo

# Feature kill-switches (optional; default = enabled)
FEATURE_ASSISTANT_ENABLED=true
FEATURE_PORTAL_ENABLED=true

# Error tracking (optional) — wire in observability adapter
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
