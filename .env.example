# =============================================================================
# PUBLIC (browser-safe) — NEXT_PUBLIC_*
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo mode: UI exploration without live Supabase. Never enable in pilot/production.
NEXT_PUBLIC_DEMO_MODE=true

# Ambiente: development | pilot | staging | production
NEXT_PUBLIC_SORRIA_ENV=development

# Piloto controlado (dados reais — projeto Supabase separado, DEMO_MODE=false)
NEXT_PUBLIC_PILOT_MODE=false

# =============================================================================
# SERVER-ONLY — never expose to the browser / client bundle
# =============================================================================
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Demo credentials (server-validated). Change in any shared environment.
DEMO_EMAIL=demo@sorria.app
DEMO_PASSWORD=sorria-demo

# Feature kill-switches (optional; default = enabled)
# No piloto: desligar Portal/Assistente se não forem validados
FEATURE_ASSISTANT_ENABLED=false
FEATURE_PORTAL_ENABLED=false

# Beta comercial
FEATURE_COMMERCIAL_BETA=true
# Signup fechado com invite code (SORRIA-BETA no seed demo)
COMMERCIAL_BETA_INVITE_ONLY=false

# Contato comercial (landing / footer)
NEXT_PUBLIC_SORRIA_CONTACT_EMAIL=contato@sorria.app
# NEXT_PUBLIC_SORRIA_CONTACT_WHATSAPP=5531999999999

# Error tracking (optional) — wire in observability adapter
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
